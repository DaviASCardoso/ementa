     "w": 243,
     "h": 20
    },
    {
     "p": "Let $x + 2 =$ 3 sin $\\theta$ . Then $dx = 3$cos $\\theta d\\theta$ and:"
    },
    {
     "img": "g1/p2-8.png",
     "w": 262,
     "h": 20
    },
