    {
     "id": "b",
     "partes": [
      {
       "p": "$\\tanh x$"
      }
     ],
     "tipo": "aberta",
     "solucao": [
      {
       "p": "sech$^{2}x = 1/$ cosh$^{2} x = 4/(e^{x} + e^{-x})^{2}$"
      }
     ]
    },
    {
     "id": "c",
     "partes": [
      {
       "p": "$\\ln(x + \\sqrt{x^{2} + 1})$"
      }
     ],
     "tipo": "aberta",
     "solucao": [
      {
       "p": "$y = x + \\sqrt{x^{2} + 1,} dy/dx = 1 + x/\\sqrt{x^{2} + 1.}$"
      },
      {
       "p": "$$\\frac{d}{dx}\\text{ ln }y = \\frac{dy/dx}{y} = \\frac{1 + x/\\sqrt{x^{2} + 1}}{x + \\sqrt{x^{2} + 1}} = \\frac{1}{\\sqrt{x^{2} + 1}}$$",
       "display": true
      }
     ]
    },
    {
     "id": "d",
     "partes": [
      {
       "p": "$y$ such that $\\cos y = x$, $0 \\leq x \\leq 1$ and $0 \\leq y \\leq \\pi/2$."
      }
     ],
     "tipo": "aberta",
     "solucao": [
      {
       "p": "cos $y = x \\Rightarrow (-$ sin $y)(dy/dx) = 1$"
      },
      {
       "p": "$$\\frac{dy}{dx} = \\frac{-1}{sin y} = \\frac{-1}{\\sqrt{1 - x^{2}}}$$",
       "display": true
      }
     ]
    },
    {
     "id": "e",
     "partes": [
      {
       "p": "$\\sin^{-1}(x/a)$"
      }
     ],
     "tipo": "aberta",
