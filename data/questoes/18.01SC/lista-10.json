     ]
    },
    {
     "id": "e",
     "partes": [
      {
       "p": "$\\frac{x^{8}}{(x + 2)^{2}(x - 2)^{2}}$ (just give the form of the solution)"
      }
     ],
     "tipo": "aberta",
     "solucao": [
      {
       "p": "$\\frac{x^{8}}{(x + 2)^{2}(x - 2)^{2}} = A_{4}x^{4}+A_{3}x^{3}+A_{2}x^{2}+A_{1}x+A_{0}+ \\frac{B_{3}x^{3} + B_{2}x^{2} + B_{1}x + B_{0}}{(x + 2)^{2}(x - 2)^{2}}$"
      }
     ]
    }
   ],
