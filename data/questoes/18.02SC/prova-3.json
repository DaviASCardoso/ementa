   "titulo": "",
   "partes": [],
   "itens": [
    {
     "id": "a",
     "partes": [
      {
       "p": "Show that F = $(3x^{2} - 6y^{2})\\hat{\\imath} + (-12xy + 4y)\\hat{\\mathbf{j}}$ is conservative."
      }
     ],
     "tipo": "aberta",
     "solucao": [
      {
       "p": "$N_{x} = -12y = M_{y}$, hence F is conservative."
      }
     ]
    },
    {
     "id": "b",
     "partes": [
      {
       "p": "Find a potential function for F."
      },
      {
       "img": "e1/p1-2.png",
       "w": 6,
       "h": 7
      }
     ],
     "tipo": "aberta",
     "solucao": [
      {
       "p": "$f_{x} = 3x^{2} - 6y^{2} \\Rightarrow f = x^{3} - 6y^{2}x + c(y) \\Rightarrow f_{y} = -12xy + c'(y) = -12xy + 4y$. So $c'(y) = 4y$, thus $c(y) = 2y^{2} (+$ constant). In conclusion"
      },
      {
       "p": "$f = x^{3} - 6xy^{2} + 2y^{2} (+$ constant)."
      }
     ]
    },
    {
     "id": "c",
     "partes": [
      {
       "p": "Let C be the curve $x = 1 + y^{3}(1 - y)^{3}, 0 \\leq y \\leq 1$. Calculate $\\mathbf{F} \\cdot d\\mathbf{r}$."
      },
